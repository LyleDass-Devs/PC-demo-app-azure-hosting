@inject IOperatorClientService OperatorClient
@inject IContractClientService ContractClient
@inject IContractRateClientService RateClient
@inject INotificationService Notifications

<BoardTile Class="tile--flush">
    <div class="toolbar">
        <div class="search">
            @((MarkupString)KubaIcons.Regular.MagnifyingGlass)
            <input class="kinput" type="search" placeholder="Search by contract or operator" aria-label="Search rates" value="@search" @oninput="OnSearchInput" />
        </div>
        <KubaSelect Items="operators" Value="operatorId" ValueChanged="OnOperatorFilter" Placeholder="All operators" AriaLabel="Operator" />
        <KubaSelect Items="contracts" Value="contractId" ValueChanged="OnContractFilter" Placeholder="All contracts" AriaLabel="Contract" />
        <KubaSelect Items="typeItems" Value="vehicleTypeId" ValueChanged="OnVehicleTypeFilter" Placeholder="All vehicle types" AriaLabel="Vehicle type" />
        <span class="toolbar__count">@countLabel</span>
        <KubaButton Text="New rate" Icon="@KubaIcons.Regular.Plus" Small="true" OnClick="() => drawer?.OpenCreate()" />
    </div>

    @if (confirmTarget is not null)
    {
        <div style="padding:12px 16px 0">
            <InlineConfirm Message="@($"Remove the rate in force on {confirmTarget.ContractNumber}? The rate before it reopens and prices from {confirmTarget.EffectiveFromDate:yyyy-MM-dd} onwards.")"
                           ConfirmText="Remove" Busy="confirmBusy" Error="@confirmError" OnConfirm="Deactivate" OnCancel="() => confirmTarget = null" />
        </div>
    }

    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudDataGrid @ref="grid" T="ContractRateResponse" ServerData="LoadServerData" SortMode="SortMode.Single" Dense="true"
                     RowsPerPage="25" Hover="true" FixedHeader="true" Height="calc(100vh - 320px)" Loading="loading" LoadingProgressColor="Color.Primary">
            <Columns>
                <TemplateColumn Title="Contract" SortBy="@(x => x.ContractNumber)" Sortable="true" Hidden="@(contractId is not null)">
                    <CellTemplate><div class="name">@context.Item.ContractNumber</div><div class="email">@context.Item.OperatorName</div></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Vehicle type" SortBy="@(x => x.VehicleType)" Sortable="true">
                    <CellTemplate><span class="chip">@context.Item.VehicleType</span></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Operated" SortBy="@(x => x.OperatedRatePerKm)" Sortable="true" CellClass="num" HeaderClass="num">
                    <CellTemplate>@($"R {context.Item.OperatedRatePerKm:N2}")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Standing" SortBy="@(x => x.StandingRatePerKm)" Sortable="true" CellClass="num" HeaderClass="num">
                    <CellTemplate>@($"R {context.Item.StandingRatePerKm:N2}")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Starts" SortBy="@(x => x.EffectiveFromDate)" Sortable="true">
                    <CellTemplate>@context.Item.EffectiveFromDate.ToString("yyyy-MM-dd")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Ends" Sortable="false">
                    <CellTemplate>@(context.Item.EffectiveToDate?.ToString("yyyy-MM-dd") ?? "Open")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status" Sortable="false">
                    <CellTemplate><StatusChip Kind="@(context.Item.IsCurrent ? StatusChip.StatusKind.Ok : StatusChip.StatusKind.Off)" Text="@(context.Item.IsCurrent ? "In force" : "Closed")" /></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false" CellStyle="width:56px">
                    <CellTemplate>
                        <button class="iconbtn" type="button" aria-label="@($"Actions for the rate from {context.Item.EffectiveFromDate:yyyy-MM-dd}")" @onclick="e => OpenRowMenu(e, context.Item)">
                            <MudIcon Icon="@KubaIcons.Regular.DotsThreeVertical" />
                        </button>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <EmptyTile Title="@(string.IsNullOrWhiteSpace(search) ? "No rates yet" : $"Nothing matches \"{search}\"")" Message="@(string.IsNullOrWhiteSpace(search) ? "Form E cannot price a month until the contract has a rate. Add the first one with New rate." : null)" Icon="@KubaIcons.Light.Bus">
                    @if (!string.IsNullOrWhiteSpace(search)) { <KubaButton Text="Clear search" Small="true" Variant="KubaButton.KubaButtonVariant.Ghost" OnClick="ClearSearch" /> }
                </EmptyTile>
            </NoRecordsContent>
            <PagerContent><MudDataGridPager T="ContractRateResponse" PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
        </MudDataGrid>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <div class="tile-list" style="padding:12px">
            @if (phoneRows.Count == 0 && !loading)
            {
                <EmptyTile Title="@(string.IsNullOrWhiteSpace(search) ? "No rates yet" : $"Nothing matches \"{search}\"")" Icon="@KubaIcons.Light.Bus" />
            }
            @foreach (ContractRateResponse row in phoneRows)
            {
                <div class="tile tile-row" @key="row.Id">
                    <span class="tile__edge" style="--edge-color:@(row.IsCurrent ? "var(--ok)" : "#C9C7D0")" aria-hidden="true"></span>
                    <div class="grow">
                        <div class="name">@($"R {row.OperatedRatePerKm:N2} operated · R {row.StandingRatePerKm:N2} standing")</div>
                        <div class="sub">@row.ContractNumber · @row.VehicleType · @row.EffectiveFromDate.ToString("yyyy-MM-dd") to @(row.EffectiveToDate?.ToString("yyyy-MM-dd") ?? "open")</div>
                    </div>
                    <button class="iconbtn" type="button" aria-label="@($"Actions for the rate from {row.EffectiveFromDate:yyyy-MM-dd}")" @onclick="e => OpenRowMenu(e, row)">
                        <MudIcon Icon="@KubaIcons.Regular.DotsThreeVertical" />
                    </button>
                </div>
            }
        </div>
    </MudHidden>
</BoardTile>

<MudMenu @ref="rowMenu" PositionAtCursor="true" Dense="true">
    @if (menuTarget is not null && menuTarget.IsCurrent)
    {
        <MudMenuItem Icon="@KubaIcons.Regular.PencilSimple" OnClick="() => drawer?.OpenEdit(menuTarget!)">Correct</MudMenuItem>
        <MudMenuItem Icon="@KubaIcons.Regular.UserMinus" OnClick="() => OnAskDeactivate(menuTarget!)">Remove</MudMenuItem>
    }
    else
    {
        <MudMenuItem Disabled="true">Closed rates cannot change</MudMenuItem>
    }
</MudMenu>

<ContractRateDrawer @ref="drawer" ContractId="contractId" Contracts="contracts" VehicleTypes="vehicleTypes" OnSaved="Reload" />

@code {
    [Parameter] public Guid? ContractId { get; set; }

    private MudDataGrid<ContractRateResponse>? grid;
    private ContractRateDrawer? drawer;
    private MudMenu? rowMenu;
    private ContractRateResponse? menuTarget;
    private ContractRateResponse? confirmTarget;
    private bool confirmBusy;
    private string? confirmError;
    private string search = string.Empty;
    private bool loading;
    private string countLabel = string.Empty;
    private Guid? operatorId, contractId;
    private List<DropDownResponse> operators = new(), contracts = new(), typeItems = new();
    private List<string> vehicleTypes = new();
    private Guid? vehicleTypeId;
    private List<ContractRateResponse> phoneRows = new();
    private System.Threading.Timer? debounce;

    protected override async Task OnInitializedAsync()
    {
        contractId = ContractId;
        operators = (await OperatorClient.GetDropDown()).Data ?? new List<DropDownResponse>();
        vehicleTypes = (await RateClient.GetVehicleTypes()).Data ?? new List<string>();
        typeItems = vehicleTypes.Select((t, i) => new DropDownResponse { Id = new Guid(i + 1, 0, 0, new byte[8]), Value = t }).ToList();
        await LoadContracts();
        await LoadPhoneRows();
    }

    private async Task LoadContracts()
    {
        contracts = (await ContractClient.GetDropDown(operatorId)).Data ?? new List<DropDownResponse>();
    }

    private ContractRateListRequest BuildRequest(int page, int pageSize, string sortBy, bool descending) => new()
    {
        ContractId = contractId,
        OperatorId = operatorId,
        VehicleType = typeItems.FirstOrDefault(t => t.Id == vehicleTypeId)?.Value,
        Page = page,
        PageSize = pageSize,
        Search = string.IsNullOrWhiteSpace(search) ? null : search,
        IsActive = true,
        SortBy = sortBy,
        SortDescending = descending
    };

    private async Task<GridData<ContractRateResponse>> LoadServerData(GridState<ContractRateResponse> state, CancellationToken cancellationToken)
    {
        loading = true;
        var sort = state.SortDefinitions.FirstOrDefault();
        string sortBy = sort is null ? "effectiveFromDate" : char.ToLowerInvariant(sort.SortBy[0]) + sort.SortBy[1..];

        var result = await RateClient.GetPaged(BuildRequest(state.Page + 1, state.PageSize, sortBy, sort?.Descending ?? sort is null));
        loading = false;

        if (!result.IsSuccess || result.Data is null)
        {
            Notifications.Notify(NotificationLevel.Error, "Could not load the rates", result.ErrorMessage);
            countLabel = string.Empty;
            return new GridData<ContractRateResponse> { Items = Array.Empty<ContractRateResponse>(), TotalItems = 0 };
        }

        int from = result.Data.ItemCount == 0 ? 0 : (result.Data.Page - 1) * result.Data.PageSize + 1;
        int to = Math.Min(result.Data.Page * result.Data.PageSize, (int)result.Data.ItemCount);
        countLabel = result.Data.ItemCount == 0 ? "No rates" : $"{from} to {to} of {result.Data.ItemCount}";

        return new GridData<ContractRateResponse> { Items = result.Data.Data, TotalItems = (int)result.Data.ItemCount };
    }

    private async Task LoadPhoneRows()
    {
        var result = await RateClient.GetPaged(BuildRequest(1, 100, "effectiveFromDate", true));
        phoneRows = result.Data?.Data ?? new List<ContractRateResponse>();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;
        debounce?.Dispose();
        debounce = new System.Threading.Timer(_ => InvokeAsync(Reload), null, 300, Timeout.Infinite);
    }

    private async Task OnOperatorFilter(Guid? id)
    {
        operatorId = id;
        contractId = null;
        await LoadContracts();
        await Reload();
    }

    private Task OnContractFilter(Guid? id)
    {
        contractId = id;
        return Reload();
    }

    private Task OnVehicleTypeFilter(Guid? id)
    {
        vehicleTypeId = id;
        return Reload();
    }

    private Task ClearSearch() { search = string.Empty; return Reload(); }

    private async Task Reload()
    {
        if (grid is not null) await grid.ReloadServerData();
        await LoadPhoneRows();
        StateHasChanged();
    }

    private async Task OpenRowMenu(MouseEventArgs e, ContractRateResponse rate)
    {
        menuTarget = rate;
        if (rowMenu is not null) await rowMenu.OpenMenuAsync(e);
    }

    private void OnAskDeactivate(ContractRateResponse rate) { confirmTarget = rate; confirmError = null; }

    private async Task Deactivate()
    {
        if (confirmTarget is null) return;
        confirmBusy = true;
        var result = await RateClient.Deactivate(confirmTarget.Id);
        confirmBusy = false;

        if (!result.IsSuccess) { confirmError = result.ErrorMessage; return; }

        string contractNumber = confirmTarget.ContractNumber;
        confirmTarget = null;
        Notifications.Notify(NotificationLevel.Success, "Rate removed", contractNumber);
        await Reload();
    }
}
