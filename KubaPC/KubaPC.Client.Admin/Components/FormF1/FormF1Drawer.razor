@inject IFormF1ClientService FormClient
@inject INotificationService Notifications

<MudDrawer @bind-Open="open" Anchor="Anchor.End" Variant="DrawerVariant.Temporary" Elevation="0" Width="min(520px, 100vw)" Class="kdrawer" ClipMode="DrawerClipMode.Never" OverlayAutoClose="true">
    <MudFocusTrap Disabled="!open" DefaultFocus="DefaultFocus.FirstChild">
        <div class="kdrawer__head">
            <h2>@(isEdit ? "Edit record" : "Capture Form F1 record")</h2>
            <button class="iconbtn kdrawer__close" type="button" aria-label="Close" @onclick="Close" disabled="@busy"><MudIcon Icon="@KubaIcons.Regular.X" /></button>
        </div>
        <p class="lede">@TripLabel</p>

        <div class="status-line" role="alert" tabindex="-1" @ref="statusLine">@error</div>

        <form @onsubmit="Save" @onsubmit:preventDefault novalidate>
            <div class="field">
                <label for="record-type">What happened</label>
                <KubaSelect Id="record-type" Items="typeItems" Value="recordTypeId" ValueChanged="OnTypeChanged" Placeholder="Choose a record type" AriaLabel="Record type" AllowEmpty="false" Invalid="@(FieldError("recordType") is not null)" />
                @if (FieldError("recordType") is string e1) { <span class="field__error">@e1</span> }
            </div>

            <div class="field">
                <label for="record-reason">Description</label>
                <input id="record-reason" class="kinput @Invalid("reason")" @bind="reason" autocomplete="off" placeholder="What was observed on the trip" />
                @if (FieldError("reason") is string e2) { <span class="field__error">@e2</span> }
            </div>

            @if (IsStandingTrip)
            {
                <div class="field">
                    <label for="record-dno-reason">Reason the trip is treated as standing</label>
                    <KubaSelect Id="record-dno-reason" Items="DnoReasons" @bind-Value="dnoReasonId" Placeholder="Choose a reason" AriaLabel="Did-not-operate reason" AllowEmpty="false" />
                    <span class="field__hint">The tracking data marked this trip as not operated. The reason explains why it is still paid at the standing rate.</span>
                </div>

                <div class="field">
                    <label for="record-dno-explanation">Explanation</label>
                    <input id="record-dno-explanation" class="kinput @Invalid("dnoExplanation")" @bind="dnoExplanation" autocomplete="off" placeholder="What happened in the operator's words" />
                    @if (FieldError("dnoExplanation") is string e3) { <span class="field__error">@e3</span> }
                </div>
            }

            @if (isEdit)
            {
                <div class="field">
                    <label for="record-change-reason">Reason for the change</label>
                    <input id="record-change-reason" class="kinput @Invalid("changeReason")" @bind="changeReason" autocomplete="off" required />
                    <span class="field__hint">Kept on the audit trail with the old and new values.</span>
                    @if (FieldError("changeReason") is string e4) { <span class="field__error">@e4</span> }
                </div>
            }

            <div class="kdrawer__actions">
                <KubaButton Text="Cancel" Variant="KubaButton.KubaButtonVariant.Ghost" OnClick="Close" Disabled="busy" />
                <KubaButton Type="submit" Text="@(isEdit ? "Save changes" : "Submit record")" Icon="@KubaIcons.Regular.Check" Busy="busy" />
            </div>
        </form>
    </MudFocusTrap>
</MudDrawer>

@code {
    [Parameter] public Guid? PaymentCertificateId { get; set; }
    [Parameter] public Guid RouteId { get; set; }
    [Parameter] public Guid TripId { get; set; }
    [Parameter] public string TripLabel { get; set; } = string.Empty;
    [Parameter] public EventCallback OnSaved { get; set; }

    private const string STANDING_TRIP = "Standing Trip";

    private bool open, isEdit, busy, lookupsLoaded;
    private Guid editingId;
    private Guid? recordTypeId, dnoReasonId;
    private string chosenType = string.Empty;
    private string? reason, dnoExplanation, changeReason, error;
    private List<DropDownResponse> typeItems = new();
    private List<DropDownResponse> DnoReasons = new();
    private IReadOnlyDictionary<string, string[]> fieldErrors = new Dictionary<string, string[]>();
    private ElementReference statusLine;

    private bool IsStandingTrip => chosenType == STANDING_TRIP;

    private static Guid IdFor(int index) => new Guid(index + 1, 0, 0, new byte[8]);

    public async Task OpenCreate()
    {
        await EnsureLookups();
        Reset();
        isEdit = false;
        open = true;
        StateHasChanged();
    }

    public async Task OpenEdit(FormF1RecordResponse record)
    {
        await EnsureLookups();
        Reset();
        isEdit = true;
        editingId = record.Id;
        chosenType = record.RecordType;
        recordTypeId = typeItems.FirstOrDefault(t => t.Value == chosenType)?.Id;
        reason = record.Reason;
        dnoReasonId = record.DnoReasonId;
        dnoExplanation = record.DnoExplanation;
        open = true;
        StateHasChanged();
    }

    private async Task EnsureLookups()
    {
        if (lookupsLoaded) return;

        var result = await FormClient.GetLookups();
        typeItems = (result.Data?.RecordTypes ?? new List<string>()).Select((t, i) => new DropDownResponse { Id = IdFor(i), Value = t }).ToList();
        DnoReasons = result.Data?.DnoReasons ?? new List<DropDownResponse>();
        lookupsLoaded = result.IsSuccess;
    }

    private void Reset()
    {
        error = null;
        fieldErrors = new Dictionary<string, string[]>();
        recordTypeId = dnoReasonId = null;
        chosenType = string.Empty;
        reason = dnoExplanation = changeReason = null;
        busy = false;
    }

    private void OnTypeChanged(Guid? id)
    {
        recordTypeId = id;
        chosenType = typeItems.FirstOrDefault(t => t.Id == id)?.Value ?? string.Empty;

        if (!IsStandingTrip)
        {
            dnoReasonId = null;
            dnoExplanation = null;
        }
    }

    private string? FieldError(string field) => fieldErrors.TryGetValue(field, out string[]? messages) ? messages.FirstOrDefault() : null;

    private string Invalid(string field) => FieldError(field) is null ? string.Empty : "invalid";

    private void Close() => open = false;

    private async Task Save()
    {
        error = null; fieldErrors = new Dictionary<string, string[]>(); busy = true;

        var result = isEdit
            ? await FormClient.Update(new UpdateFormF1RecordRequest
            {
                Id = editingId,
                RouteId = RouteId,
                TripId = TripId,
                RecordType = chosenType,
                Reason = reason ?? string.Empty,
                DnoReasonId = dnoReasonId,
                DnoExplanation = dnoExplanation,
                ChangeReason = changeReason ?? string.Empty
            })
            : (await FormClient.Create(new CreateFormF1RecordRequest
            {
                PaymentCertificateId = PaymentCertificateId,
                RouteId = RouteId,
                TripId = TripId,
                RecordType = chosenType,
                Reason = reason ?? string.Empty,
                DnoReasonId = dnoReasonId,
                DnoExplanation = dnoExplanation
            })) as KubaPC.SharedClient.Services.Models.ApiResult;

        busy = false;

        if (!result.IsSuccess)
        {
            fieldErrors = result.ValidationErrors;
            error = result.HasValidationErrors ? null : result.ErrorMessage;
            if (error is not null) await statusLine.FocusAsync();
            return;
        }

        open = false;
        Notifications.Notify(NotificationLevel.Success, isEdit ? "Record updated" : "Form F1 record captured", chosenType);
        await OnSaved.InvokeAsync();
    }
}
