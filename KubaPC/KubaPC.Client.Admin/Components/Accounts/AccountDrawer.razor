@inject IAccountClientService AccountClient
@inject IRoleClientService Roles
@inject IOperatorClientService OperatorClient
@inject INotificationService Notifications

<MudDrawer @bind-Open="open" Anchor="Anchor.End" Variant="DrawerVariant.Temporary" Elevation="0" Width="min(480px, 100vw)" Class="kdrawer" ClipMode="DrawerClipMode.Never" OverlayAutoClose="true">
    <MudFocusTrap Disabled="!open" DefaultFocus="DefaultFocus.FirstChild">
        <div class="kdrawer__head">
            <h2>@(isEdit ? "Edit account" : "New account")</h2>
            <button class="iconbtn kdrawer__close" type="button" aria-label="Close" @onclick="Close" disabled="@busy"><MudIcon Icon="@KubaIcons.Regular.X" /></button>
        </div>
        <p class="lede">@(isEdit ? editingEmail : "A temporary password is generated when you save. Pass it on; they replace it at first sign-in.")</p>

        <div class="status-line" role="alert" tabindex="-1" @ref="statusLine">@error</div>

        <form @onsubmit="Save" @onsubmit:preventDefault novalidate>
            <div class="field">
                <label for="full-name">Full name</label>
                <input id="full-name" class="kinput @(FieldError("fullName") is not null ? "invalid" : "")" @bind="fullName" autocomplete="name" required />
                @if (FieldError("fullName") is string fe)
                {
                    <span class="field__error">@fe</span>
                }
            </div>

            @if (!isEdit)
            {
                <div class="field">
                    <label for="email-address">Email address</label>
                    <input id="email-address" class="kinput @(FieldError("emailAddress") is not null ? "invalid" : "")" type="email" @bind="email" autocomplete="off" inputmode="email" required />
                    @if (FieldError("emailAddress") is string ee)
                    {
                        <span class="field__error">@ee</span>
                    }
                </div>
            }

            <div class="field">
                <label>Roles</label>
                @if (isSelf)
                {
                    <span class="field__hint">You cannot change the roles on your own account.</span>
                }
                <div class="chips" style="gap:8px;margin-top:4px">
                    @foreach (DropDownResponse role in roles)
                    {
                        bool on = selectedRoles.Contains(role.Value);
                        <button type="button" class="chip chip--toggle @(on ? "chip--on" : "")" aria-pressed="@(on ? "true" : "false")" disabled="@isSelf" @onclick="() => ToggleRole(role.Value)">@role.Value</button>
                    }
                </div>
                @if (FieldError("roleNames") is string re)
                {
                    <span class="field__error">@re</span>
                }
            </div>

            @if (NeedsOperators)
            {
                <div class="field">
                    <label for="account-operators">Operators</label>
                    <span class="field__hint">@(IsSingleOperator ? "Operator Staff work for one bus company. Search for it and tick it." : "Which bus companies this person may work on. Tick as many as apply, or none.")</span>
                    <KubaMultiPick Id="account-operators" Items="operators" Value="selectedOperatorIds" ValueChanged="OnOperatorsChanged" Single="IsSingleOperator"
                                   Placeholder="Search operators" AriaLabel="Operators" EmptyText="No active operators yet. Add one under Operators first." />
                </div>
            }

            <div class="kdrawer__actions">
                <KubaButton Text="Cancel" Variant="KubaButton.KubaButtonVariant.Ghost" OnClick="Close" Disabled="busy" />
                <KubaButton Type="submit" Text="@(isEdit ? "Save changes" : "Create account")" Icon="@KubaIcons.Regular.Check" Busy="busy" />
            </div>
        </form>

        @if (isEdit && !isSelf && isTargetActive)
        {
            <section class="drawer-section">
                <h3>Password</h3>
                @if (generatedPassword is not null)
                {
                    <p class="drawer-section__hint">Temporary password for @fullName. Pass it on now; it is shown once and expires on @generatedExpiry.ToLocalTime().ToString("d MMMM yyyy 'at' HH:mm").</p>
                    <input class="kinput" value="@generatedPassword" readonly aria-label="Temporary password" />
                    <div class="drawer-section__actions">
                        <KubaButton Text="Done" Small="true" Variant="KubaButton.KubaButtonVariant.Ghost" OnClick="CloseReset" />
                    </div>
                }
                else if (!isResetOpen)
                {
                    <p class="drawer-section__hint">Forgotten password? Generate a temporary one; they choose their own at next sign-in.</p>
                    <KubaButton Text="Reset password" Icon="@KubaIcons.Regular.Key" Small="true" Variant="KubaButton.KubaButtonVariant.Ghost" OnClick="() => isResetOpen = true" />
                }
                else
                {
                    <form @onsubmit="ResetPassword" @onsubmit:preventDefault novalidate>
                        <div class="status-line" role="alert" tabindex="-1" @ref="resetStatusLine">@resetError</div>
                        <p class="drawer-section__hint">This signs @fullName out everywhere and replaces their password with a generated one that lasts three days.</p>
                        <div class="drawer-section__actions">
                            <KubaButton Text="Cancel" Small="true" Variant="KubaButton.KubaButtonVariant.Ghost" OnClick="CloseReset" Disabled="resetBusy" />
                            <KubaButton Type="submit" Text="Generate temporary password" Small="true" Icon="@KubaIcons.Regular.Key" Busy="resetBusy" />
                        </div>
                    </form>
                }
            </section>
        }
    </MudFocusTrap>
</MudDrawer>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool open, isEdit, isSelf, busy;
    private Guid editingId;
    private string editingEmail = string.Empty, fullName = string.Empty, email = string.Empty;
    private readonly HashSet<string> selectedRoles = new();
    private List<DropDownResponse> roles = new();
    private List<DropDownResponse> operators = new();
    private readonly HashSet<Guid> selectedOperatorIds = new();

    private static readonly string[] OPERATOR_SCOPED_ROLES = { "Authoriser", "Operator Staff", "Admin" };

    private bool NeedsOperators => selectedRoles.Overlaps(OPERATOR_SCOPED_ROLES);

    private bool IsSingleOperator => selectedRoles.Contains("Operator Staff");
    private string? error;
    private IReadOnlyDictionary<string, string[]> fieldErrors = new Dictionary<string, string[]>();
    private ElementReference statusLine;

    private bool isTargetActive, isResetOpen, resetBusy;
    private string? generatedPassword;
    private DateTime generatedExpiry;
    private string? resetError;
    private IReadOnlyDictionary<string, string[]> resetFieldErrors = new Dictionary<string, string[]>();
    private ElementReference resetStatusLine;

    public async void OpenCreate()
    {
        Reset();
        isEdit = false;
        await EnsureRoles();
        await EnsureOperators();
        open = true;
        StateHasChanged();
    }

    public async void OpenEdit(AccountListResponse account, bool self)
    {
        Reset(); isEdit = true; isSelf = self;
        editingId = account.Id; editingEmail = account.EmailAddress; fullName = account.FullName; isTargetActive = account.IsActive;
        foreach (string role in (account.RoleNames ?? "").Split(", ", StringSplitOptions.RemoveEmptyEntries)) selectedRoles.Add(role);
        await EnsureRoles();
        await EnsureOperators();
        var granted = await AccountClient.GetOperatorIds(account.Id);
        foreach (Guid id in granted.Data ?? new List<Guid>()) selectedOperatorIds.Add(id);
        open = true; StateHasChanged();
    }

    private void Reset()
    {
        error = null;
        fieldErrors = new Dictionary<string, string[]>();
        fullName = email = string.Empty;
        selectedRoles.Clear(); selectedOperatorIds.Clear(); isSelf = false;
        busy = false;
        CloseReset();
    }

    private void CloseReset()
    {
        isResetOpen = false; resetBusy = false; generatedPassword = null;
        resetError = null; resetFieldErrors = new Dictionary<string, string[]>();
    }

    private async Task ResetPassword()
    {
        resetError = null; resetFieldErrors = new Dictionary<string, string[]>(); resetBusy = true;
        var result = await AccountClient.ResetPassword(new ResetPasswordRequest { Id = editingId });
        resetBusy = false;

        if (!result.IsSuccess || result.Data is null)
        {
            resetFieldErrors = result.ValidationErrors;
            resetError = result.HasValidationErrors ? null : result.ErrorMessage;
            if (resetError is not null) await resetStatusLine.FocusAsync();
            return;
        }

        isResetOpen = false;
        generatedPassword = result.Data.TemporaryPassword;
        generatedExpiry = result.Data.ExpiresAt;
        Notifications.Notify(NotificationLevel.Success, "Password reset", $"{fullName} has been signed out and must use the temporary password next.");
    }

    private async Task EnsureRoles()
    {
        if (roles.Count > 0) return;
        var result = await Roles.GetAll();
        roles = result.Data ?? new List<DropDownResponse>();
        if (!result.IsSuccess) Notifications.Notify(NotificationLevel.Error, "Could not load roles", result.ErrorMessage);
    }

    private void ToggleRole(string role)
    {
        if (!selectedRoles.Remove(role))
            selectedRoles.Add(role);
        if (IsSingleOperator && selectedOperatorIds.Count > 1)
            selectedOperatorIds.IntersectWith(new[] { selectedOperatorIds.First() });
    }

    private void OnOperatorsChanged(HashSet<Guid> ids)
    {
        selectedOperatorIds.Clear();
        selectedOperatorIds.UnionWith(ids);
    }

    private async Task EnsureOperators()
    {
        if (operators.Count > 0) return;
        var result = await OperatorClient.GetDropDown();
        operators = result.Data ?? new List<DropDownResponse>();
    }

    private string? FieldError(string field) => fieldErrors.TryGetValue(field, out string[]? messages) ? messages.FirstOrDefault() : null;

    private void Close() => open = false;

    private async Task Save()
    {
        error = null; fieldErrors = new Dictionary<string, string[]>(); busy = true;

        var result = isEdit
            ? await AccountClient.Update(new UpdateAccountRequest { Id = editingId, FullName = fullName, RoleNames = selectedRoles.ToList() })
            : (await AccountClient.Create(new CreateAccountRequest { FullName = fullName, EmailAddress = email, RoleNames = selectedRoles.ToList() })) as KubaPC.SharedClient.Services.Models.ApiResult;

        busy = false;

        if (!result.IsSuccess)
        {
            fieldErrors = result.ValidationErrors;
            error = result.HasValidationErrors ? null : result.ErrorMessage;
            if (error is not null) await statusLine.FocusAsync();
            return;
        }

        CreateAccountResponse? created = isEdit ? null : ((KubaPC.SharedClient.Services.Models.ApiResult<CreateAccountResponse>)result).Data;
        Guid accountId = isEdit ? editingId : created!.Id;
        List<Guid> wanted = NeedsOperators ? selectedOperatorIds.ToList() : new List<Guid>();
        var grants = await AccountClient.UpdateOperators(new UpdateAccountOperatorsRequest { AccountId = accountId, OperatorIds = wanted });

        if (!grants.IsSuccess)
        {
            error = grants.ErrorMessage ?? "The account was saved but its operators were not.";
            await statusLine.FocusAsync();
            return;
        }

        if (created is not null)
        {
            ShowTemporaryPassword(accountId, email, created.TemporaryPassword, created.ExpiresAt);
            Notifications.Notify(NotificationLevel.Success, "Account created", $"Pass the temporary password on to {fullName}.");
            await OnSaved.InvokeAsync();
            return;
        }

        open = false;
        Notifications.Notify(NotificationLevel.Success, "Account updated", fullName);
        await OnSaved.InvokeAsync();
    }

    public void ShowTemporaryPassword(Guid accountId, string emailAddress, string temporaryPassword, DateTime expiresAt)
    {
        isEdit = true; isSelf = false; isTargetActive = true; isResetOpen = false;
        editingId = accountId; editingEmail = emailAddress;
        generatedPassword = temporaryPassword; generatedExpiry = expiresAt;
        open = true;
        StateHasChanged();
    }
}
