@page "/operators"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "SuperAdmin,Admin")]
@inject IOperatorClientService OperatorClient
@inject INotificationService Notifications
@inject NavigationManager Navigation
@inject PageHeader Header

<PageTitle>Operators · KubaPC Admin</PageTitle>

<BackLink Fallback="@ClientRoutes.HOME" />

<BoardTile Class="tile--flush">
    <div class="toolbar">
        <div class="search">
            @((MarkupString)KubaIcons.Regular.MagnifyingGlass)
            <input class="kinput" type="search" placeholder="Search by name or company code" aria-label="Search operators" value="@search" @oninput="OnSearchInput" />
        </div>
        <div class="seg" role="group" aria-label="Show">
            <button type="button" aria-pressed="@(isActive ? "true" : "false")" @onclick="() => SetActive(true)">Active</button>
            <button type="button" aria-pressed="@(isActive ? "false" : "true")" @onclick="() => SetActive(false)">Inactive</button>
        </div>
        <span class="toolbar__count">@countLabel</span>
        @if (canCreate)
        {
            <KubaButton Text="New operator" Icon="@KubaIcons.Regular.Plus" Small="true" OnClick="() => drawer?.OpenCreate()" />
        }
    </div>

    @if (!isActive)
    {
        <p class="readonly-note">Inactive operators keep their contracts and history. Reactivate one to use it again.</p>
    }

    @if (confirmTarget is not null)
    {
        <div style="padding:12px 16px 0">
            <InlineConfirm Message="@($"Deactivate {confirmTarget.OperatorName}? Its contracts and vehicles stay on record but no new work can be captured for it.")"
                           ConfirmText="Deactivate" Busy="confirmBusy" Error="@confirmError" OnConfirm="Deactivate" OnCancel="() => confirmTarget = null" />
        </div>
    }

    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudDataGrid @ref="grid" T="OperatorListResponse" ServerData="LoadServerData" SortMode="SortMode.Single" Dense="true"
                     RowsPerPage="25" Hover="true" FixedHeader="true" Height="calc(100vh - 260px)" Loading="loading" LoadingProgressColor="Color.Primary">
            <Columns>
                <TemplateColumn Title="Operator" SortBy="@(x => x.OperatorName)" Sortable="true">
                    <CellTemplate><div class="name">@context.Item.OperatorName</div><div class="email">@context.Item.IdSociete</div></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Contracts" Sortable="false">
                    <CellTemplate><a class="cell-link" href="@ClientRoutes.Contracts(context.Item.Id)">@context.Item.ContractCount</a></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Vehicles" Sortable="false">
                    <CellTemplate>@context.Item.VehicleCount</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status" Sortable="false">
                    <CellTemplate><StatusChip Kind="@(context.Item.IsActive ? StatusChip.StatusKind.Ok : StatusChip.StatusKind.Off)" Text="@(context.Item.IsActive ? "Active" : "Deactivated")" /></CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Added" SortBy="@(x => x.CreatedAt)" Sortable="true">
                    <CellTemplate>@context.Item.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false" CellStyle="width:56px">
                    <CellTemplate>
                        <button class="iconbtn" type="button" aria-label="@($"Actions for {context.Item.OperatorName}")" @onclick="e => OpenRowMenu(e, context.Item)">
                            <MudIcon Icon="@KubaIcons.Regular.DotsThreeVertical" />
                        </button>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <EmptyTile Title="@(string.IsNullOrWhiteSpace(search) ? "No operators yet" : $"Nothing matches \"{search}\"")" Message="@(string.IsNullOrWhiteSpace(search) && canCreate ? "Add the first bus company with New operator." : null)" Icon="@KubaIcons.Light.Bus">
                    @if (!string.IsNullOrWhiteSpace(search)) { <KubaButton Text="Clear search" Small="true" Variant="KubaButton.KubaButtonVariant.Ghost" OnClick="ClearSearch" /> }
                </EmptyTile>
            </NoRecordsContent>
            <PagerContent><MudDataGridPager T="OperatorListResponse" PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
        </MudDataGrid>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <div class="tile-list" style="padding:12px">
            @if (phoneRows.Count == 0 && !loading)
            {
                <EmptyTile Title="@(string.IsNullOrWhiteSpace(search) ? "No operators yet" : $"Nothing matches \"{search}\"")" Icon="@KubaIcons.Light.Bus" />
            }
            @foreach (OperatorListResponse row in phoneRows)
            {
                <div class="tile tile-row" @key="row.Id">
                    <span class="tile__edge" style="--edge-color:@(row.IsActive ? "var(--ok)" : "#C9C7D0")" aria-hidden="true"></span>
                    <div class="grow">
                        <div class="name">@row.OperatorName</div>
                        <div class="sub">@row.IdSociete · @row.ContractCount contracts · @row.VehicleCount vehicles</div>
                    </div>
                    <button class="iconbtn" type="button" aria-label="@($"Actions for {row.OperatorName}")" @onclick="e => OpenRowMenu(e, row)">
                        <MudIcon Icon="@KubaIcons.Regular.DotsThreeVertical" />
                    </button>
                </div>
            }
        </div>
    </MudHidden>
</BoardTile>

<MudMenu @ref="rowMenu" PositionAtCursor="true" Dense="true">
    <MudMenuItem Icon="@KubaIcons.Regular.PencilSimple" OnClick="() => drawer?.OpenEdit(menuTarget!)">Edit</MudMenuItem>
    <MudMenuItem Icon="@KubaIcons.Regular.ClipboardText" OnClick="() => Navigation.NavigateTo(ClientRoutes.Contracts(menuTarget!.Id))">Contracts</MudMenuItem>
    @if (menuTarget is not null && menuTarget.IsActive)
    {
        <MudMenuItem Icon="@KubaIcons.Regular.UserMinus" OnClick="() => OnAskDeactivate(menuTarget!)">Deactivate</MudMenuItem>
    }
    @if (menuTarget is not null && !menuTarget.IsActive)
    {
        <MudMenuItem Icon="@KubaIcons.Regular.UserPlus" OnClick="() => Reactivate(menuTarget!)">Reactivate</MudMenuItem>
    }
</MudMenu>

<OperatorDrawer @ref="drawer" OnSaved="Reload" />

@code {
    private MudDataGrid<OperatorListResponse>? grid;
    private OperatorDrawer? drawer;
    private MudMenu? rowMenu;
    private OperatorListResponse? menuTarget;
    private OperatorListResponse? confirmTarget;
    private bool confirmBusy;
    private string? confirmError;
    private string search = string.Empty;
    private bool isActive = true;
    private bool loading;
    private string countLabel = string.Empty;
    private bool canCreate;
    private List<OperatorListResponse> phoneRows = new();

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }
    private System.Threading.Timer? debounce;

    protected override async Task OnInitializedAsync()
    {
        Header.Set("Operators");

        if (AuthenticationState is not null)
        {
            AuthenticationState state = await AuthenticationState;
            canCreate = state.User.IsInRole("SuperAdmin");
        }

        await LoadPhoneRows();
    }

    private OperatorListRequest BuildRequest(int page, int pageSize, string sortBy, bool descending) => new()
    {
        Page = page,
        PageSize = pageSize,
        Search = string.IsNullOrWhiteSpace(search) ? null : search,
        IsActive = isActive,
        SortBy = sortBy,
        SortDescending = descending
    };

    private async Task<GridData<OperatorListResponse>> LoadServerData(GridState<OperatorListResponse> state, CancellationToken cancellationToken)
    {
        loading = true;
        var sort = state.SortDefinitions.FirstOrDefault();
        string sortBy = sort is null ? "operatorName" : char.ToLowerInvariant(sort.SortBy[0]) + sort.SortBy[1..];

        var result = await OperatorClient.GetPaged(BuildRequest(state.Page + 1, state.PageSize, sortBy, sort?.Descending ?? false));
        loading = false;

        if (!result.IsSuccess || result.Data is null)
        {
            Notifications.Notify(NotificationLevel.Error, "Could not load operators", result.ErrorMessage);
            countLabel = string.Empty;
            return new GridData<OperatorListResponse> { Items = Array.Empty<OperatorListResponse>(), TotalItems = 0 };
        }

        int from = result.Data.ItemCount == 0 ? 0 : (result.Data.Page - 1) * result.Data.PageSize + 1;
        int to = Math.Min(result.Data.Page * result.Data.PageSize, (int)result.Data.ItemCount);
        countLabel = result.Data.ItemCount == 0 ? "No operators" : $"{from} to {to} of {result.Data.ItemCount}";

        return new GridData<OperatorListResponse> { Items = result.Data.Data, TotalItems = (int)result.Data.ItemCount };
    }

    private async Task LoadPhoneRows()
    {
        var result = await OperatorClient.GetPaged(BuildRequest(1, 100, "operatorName", false));
        phoneRows = result.Data?.Data ?? new List<OperatorListResponse>();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;
        debounce?.Dispose();
        debounce = new System.Threading.Timer(_ => InvokeAsync(Reload), null, 300, Timeout.Infinite);
    }

    private Task ClearSearch() { search = string.Empty; return Reload(); }

    private Task SetActive(bool value) { isActive = value; confirmTarget = null; return Reload(); }

    private async Task Reload()
    {
        if (grid is not null) await grid.ReloadServerData();
        await LoadPhoneRows();
        StateHasChanged();
    }

    private async Task OpenRowMenu(MouseEventArgs e, OperatorListResponse item)
    {
        menuTarget = item;
        if (rowMenu is not null) await rowMenu.OpenMenuAsync(e);
    }

    private void OnAskDeactivate(OperatorListResponse item) { confirmTarget = item; confirmError = null; }

    private async Task Deactivate()
    {
        if (confirmTarget is null) return;
        confirmBusy = true;
        var result = await OperatorClient.Deactivate(confirmTarget.Id);
        confirmBusy = false;

        if (!result.IsSuccess) { confirmError = result.ErrorMessage; return; }

        string name = confirmTarget.OperatorName;
        confirmTarget = null;
        Notifications.Notify(NotificationLevel.Success, $"{name} deactivated", null, new NotificationAction("View inactive", () => SetActive(false)));
        await Reload();
    }

    private async Task Reactivate(OperatorListResponse item)
    {
        var result = await OperatorClient.Reactivate(item.Id);

        if (!result.IsSuccess)
        {
            Notifications.Notify(NotificationLevel.Error, "Could not reactivate", result.ErrorMessage);
            return;
        }

        Notifications.Notify(NotificationLevel.Success, $"{item.OperatorName} reactivated", null, new NotificationAction("View active", () => SetActive(true)));
        await Reload();
    }
}
