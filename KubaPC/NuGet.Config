<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Solution-scoped package sources.

    <clear /> discards every source inherited from the machine and user-level
    NuGet.Config files. The user-level config on at least one developer machine
    registers an internal feed over plain HTTP, which NuGet 6 and later refuse
    outright (error NU1302), and that failure blocks restore for the whole
    solution even though this project consumes no packages from that feed.

    Clearing also means a fresh clone or a build agent restores from exactly one
    source, so a build cannot silently succeed because of a package that happens
    to be cached on one machine.

    If an internal package is ever genuinely required here, add its feed below
    rather than removing this file.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
