@page "/forgot-password"
@layout FocusedLayout
@inject IMotionService Motion
@inject NavigationManager Navigation
@inject AppInfo App

<PageTitle>Forgot password · @App.Title</PageTitle>

<div class="entry on-indigo">
    <div class="entry__lock">
        <KubaMark Size="56" />
        <KubaWordmark Height="26" Class="entry__word" />
    </div>

    <div class="entry__tile" @ref="tile">
        <BackLink Fallback="@ClientRoutes.LOGIN" Text="Back to sign in" />
        <h1>Forgot your password?</h1>
        <p>Passwords are reset by your administrator.</p>

        <ol class="entry__steps">
            <li>Ask your administrator to reset your password.</li>
            <li>They give you a temporary password.</li>
            <li>Sign in with it and choose your own password.</li>
        </ol>
    </div>
    <div class="entry__foot">Kuba Payment Certificate</div>
</div>

@code {
    private ElementReference tile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Motion.Animate(tile, "entry-tile");
    }
}
