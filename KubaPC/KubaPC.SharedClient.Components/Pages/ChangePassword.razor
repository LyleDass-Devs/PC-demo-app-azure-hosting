@page "/change-password"
@layout FocusedLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject AppInfo App

<PageTitle>Choose your password · @App.Title</PageTitle>
<div class="entry on-indigo">
    <div class="entry__lock">
        <KubaMark Size="40" />
        <KubaWordmark Height="26" Class="entry__word" />
    </div>
     <div class="entry__tile">
        <h1>Choose your own password</h1>
        <p>Your administrator set this password. Choose your own to continue.</p>
        <PasswordChangeForm Forced="true" ReturnUrl="@ReturnUrl" />
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
}
