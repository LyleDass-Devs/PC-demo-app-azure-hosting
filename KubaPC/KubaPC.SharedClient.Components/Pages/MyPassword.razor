@page "/me/password"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject PageHeader Header
@inject AppInfo App

<PageTitle>Change password · @App.Title</PageTitle>

<div style="max-width:440px">
    <BoardTile Title="Choose a new password" Subtitle="You will stay signed in.">
        <div style="height:12px"></div>
        <PasswordChangeForm Forced="false" ReturnUrl="@ClientRoutes.ME" />
    </BoardTile>
</div>

@code {
    protected override void OnInitialized() => Header.Set("Change password");
}