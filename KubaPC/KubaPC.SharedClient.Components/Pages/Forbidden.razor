@inject NavigationManager Navigation
@inject PageHeader Header
@inject AppInfo App

<PageTitle>Not your role · @App.Title</PageTitle>

<div class="stray">
    <EmptyTile Title="Not your role" Message="Your account does not have access to this screen. Ask an administrator if you think it should." Icon="@KubaIcons.Light.ShieldCheck">
        <KubaButton Text="Back to home" Icon="@KubaIcons.Regular.ArrowRight" Small="true"
                    OnClick="@(() => Navigation.NavigateTo(ClientRoutes.HOME))" />
    </EmptyTile>
</div>

@code {
    protected override void OnInitialized() => Header.Set("Not your role");
}
