@inject NavigationManager navigationManager

@code {
    // Sends an unauthenticated visitor to the login page, remembering where they
    // were headed so they can be returned there after signing in.
    protected override void OnInitialized()
    {
        string returnUrl = navigationManager.ToBaseRelativePath(navigationManager.Uri);

        string target = string.IsNullOrWhiteSpace(returnUrl)
            ? ClientRoutes.LOGIN
            : $"{ClientRoutes.LOGIN}?returnUrl={Uri.EscapeDataString(returnUrl)}";

        navigationManager.NavigateTo(target, replace: true);
    }
}
