@inject INotificationService Notifications
@implements IDisposable

<div class="notify" aria-live="polite">
    @foreach (NotificationItem item in Notifications.Items)
    {
        <div class="notify__item notify__item--@LevelClass(item.Level)" @key="item.Id" style="--life:@LifeSeconds" role="@(item.Level == NotificationLevel.Error ? "alert" : "status")"
             @onmouseenter="() => Notifications.Hold(item.Id)" @onmouseleave="() => Notifications.Release(item.Id)"
             @onfocusin="() => Notifications.Hold(item.Id)" @onfocusout="() => Notifications.Release(item.Id)">
            <div class="notify__row">
                <div>
                    <p class="notify__title">@item.Title</p>
                    @if (!string.IsNullOrEmpty(item.Message))
                    {
                        <p class="notify__msg">@item.Message</p>
                    }
                    @if (item.Action is not null)
                    {
                        <button class="notify__action" type="button" @onclick="() => RunAction(item)">@item.Action.Label</button>
                    }
                </div>
                <button class="notify__close" type="button" aria-label="Dismiss" @onclick="() => Notifications.Dismiss(item.Id)">
                    <MudIcon Icon="@KubaIcons.Regular.X" Style="width:16px;height:16px" />
                </button>
            </div>
            @if (item.AutoDismiss)
            {
                <span class="notify__bar" aria-hidden="true"></span>
            }
        </div>
    }
</div>

@code {
    private static string LifeSeconds => $"{NotificationService.LIFETIME.TotalSeconds:0}s";

    protected override void OnInitialized() => Notifications.Changed += StateHasChanged;

    private static string LevelClass(NotificationLevel level) => level switch
    {
        NotificationLevel.Success => "success",
        NotificationLevel.Warning => "warning",
        NotificationLevel.Error => "error",
        _ => "info"
    };

    private async Task RunAction(NotificationItem item)
    {
        Notifications.Dismiss(item.Id);

        if (item.Action is not null)
        {
            await item.Action.Invoke();
        }
    }

    public void Dispose() => Notifications.Changed -= StateHasChanged;
}
