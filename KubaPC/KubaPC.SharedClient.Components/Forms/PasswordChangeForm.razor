@inject IAccountClientService Accounts
@inject IAuthenticationClientService Authentication
@inject ICurrentUserService CurrentUser
@inject INotificationService Notifications
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState

<form @onsubmit="Submit" @onsubmit:preventDefault novalidate>
    <div class="form-error" role="alert">@error</div>

    <PasswordField @bind-Value="request.OldPassword" Label="Current password" Id="old-password" AutoComplete="current-password" Error="@FieldError("oldPassword")" />
    <PasswordField @bind-Value="request.NewPassword" Label="New password" Id="new-password" AutoComplete="new-password" Error="@FieldError("newPassword")" />
    <PasswordStrengthLine Value="@request.NewPassword" />
    <div style="height:14px"></div>
    <PasswordField @bind-Value="confirm" Label="Confirm new password" Id="confirm-password" AutoComplete="new-password" Error="@confirmError" />

    <KubaButton Type="submit" Text="@(Forced ? "Save and continue" : "Change password")" Icon="@KubaIcons.Regular.ArrowRight" Busy="busy" Block="true" />
</form>

@code {
    [Parameter] public bool Forced { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }

    private readonly ChangePasswordRequest request = new();
    private string confirm = string.Empty;
    private string? confirmError;
    private string? error;
    private bool busy;
    private IReadOnlyDictionary<string, string[]> fieldErrors = new Dictionary<string, string[]>();

    private string? FieldError(string field) => fieldErrors.TryGetValue(field, out string[]? messages) ? messages.FirstOrDefault() : null;

    private async Task Submit()
    {
        error = null;
        confirmError = null;
        fieldErrors = new Dictionary<string, string[]>();

        if (confirm != request.NewPassword)
        {
            confirmError = "The two passwords do not match.";
            return;
        }

        busy = true;
        var result = await Accounts.ChangePassword(request);

        if (!result.IsSuccess)
        {
            busy = false;
            fieldErrors = result.ValidationErrors;
            error = result.HasValidationErrors ? null : result.ErrorMessage;
            return;
        }
        
        // The email is a claim in the token we already hold; asking the API would be refused
        // while the must-change claim is still on that token.
        string? email = (await AuthState.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        var login = string.IsNullOrEmpty(email) ? null : await Authentication.Login(new AuthenticationRequest { EmailAddress = email, Password = request.NewPassword });

        busy = false;

        if (login is { IsSuccess: true })
        {
            await CurrentUser.Refresh();
            Notifications.Notify(NotificationLevel.Success, "Password changed");
            Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? ClientRoutes.HOME : ReturnUrl);
            return;
        }

        await Authentication.SignOut();
        Navigation.NavigateTo($"{ClientRoutes.LOGIN}?changed=1");

    }
}
