@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

<a class="backlink" href="@Fallback" @onclick="Go" @onclick:preventDefault>
    @((MarkupString)KubaIcons.Regular.ArrowLeft)
    <span>@Text</span>
</a>

@code {
    [Parameter, EditorRequired] public string Fallback { get; set; } = "/";
    [Parameter] public string Text { get; set; } = "Back";

    // Go where the person came from when the app has a history entry, otherwise to the sensible parent.
    private async Task Go()
    {
        bool hasHistory = await JavaScript.InvokeAsync<bool>("kubaMotion.canGoBack");

        if (hasHistory)
        {
            await JavaScript.InvokeVoidAsync("history.back");
            return;
        }

        Navigation.NavigateTo(Fallback);
    }
}
