<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!--
      See the matching comment in KubaPC.Client.Admin. Both clients are hosted by
      the same API, so each needs its own base path or their _framework/ output
      collides. This value must match the branch this client is mapped to in
      KubaPC.API/Startup.cs.
    -->
    <StaticWebAssetBasePath>cert</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KubaPC.Models\KubaPC.Models.csproj" />
    <ProjectReference Include="..\KubaPC.SharedClient.Components\KubaPC.SharedClient.Components.csproj" />
    <ProjectReference Include="..\KubaPC.SharedClient.Services\KubaPC.SharedClient.Services.csproj" />
  </ItemGroup>

</Project>
